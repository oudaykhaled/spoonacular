## Copy this file to local.properties and fill in your own values.
## DO NOT commit local.properties.
## Android SDK path — typically auto-populated by Android Studio.
sdk.dir=/absolute/path/to/your/Android/sdk

## Spoonacular API key — get a free one at https://spoonacular.com/food-api
SPOONACULAR_API_KEY=your_spoonacular_api_key_here
